							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 400 Bad Request', function () {",
									"    pm.response.to.have.status(400);",
									"});",
									"pm.test('Error message indicates email already used', function () {",
									"    const json = pm.response.json();",
