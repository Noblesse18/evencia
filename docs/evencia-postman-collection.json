		{
			"name": "02 - Users",
			"description": "User profile management tests: get profile, update profile, get by ID",
			"item": [
				{
					"name": "Get My Profile",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{participant_token}}" }
