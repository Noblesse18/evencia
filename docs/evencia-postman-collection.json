{
	"info": {
		"_postman_id": "evencia-api-tests",
		"name": "Evencia API Tests",
		"description": "Complete API test collection for the Evencia event management platform. Covers authentication, users, events, inscriptions, payments, and cleanup workflows.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:5000/api"
		}
	],
	"item": [
		{
			"name": "01 - Auth",
			"description": "Authentication tests: register, login, token verification, password management",
			"item": [
				{
					"name": "Register Participant",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"{{participant_name}}\",\n  \"email\": \"{{participant_email}}\",\n  \"password\": \"{{participant_password}}\",\n  \"role\": \"participant\"\n}"
						},
						"url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 201 Created', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test('Response has user object and token', function () {",
									"    const json = pm.response.json();",
									"    pm.expect(json).to.have.property('user');",
									"    pm.expect(json).to.have.property('token');",
									"    pm.expect(json.token).to.be.a('string').and.not.empty;",
									"});",
									"pm.test('User has correct fields', function () {",
									"    const user = pm.response.json().user;",
									"    pm.expect(user).to.have.property('id');",
									"    pm.expect(user).to.have.property('name', pm.environment.get('participant_name'));",
									"    pm.expect(user).to.have.property('email', pm.environment.get('participant_email'));",
									"    pm.expect(user).to.have.property('role', 'participant');",
									"});",
									"pm.test('Store participant token and ID', function () {",
									"    const json = pm.response.json();",
									"    pm.environment.set('participant_token', json.token);",
									"    pm.environment.set('participant_id', json.user.id);",
									"});"
								]
							}
						}
					]
				},
